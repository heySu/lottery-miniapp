page {
    min-height: 100%;
    background: #f5f7fa;
    color: #1f2329;
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

/* 自定义 tabBar 为浮层，tab 页需预留底部空间（配合 wxml 根节点 tabbed 类） */
.page.tabbed {
    padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
    box-sizing: border-box;
}

button {
    border-radius: 12rpx;
}

.card {
    background: #ffffff;
    border-radius: 20rpx;
    margin: 20rpx 24rpx;
    padding: 28rpx;
    box-shadow: 0 4rpx 16rpx rgba(31, 35, 41, 0.04);
}

.section-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #1f2329;
    margin-bottom: 20rpx;
}

.ball {
    width: 64rpx;
    height: 64rpx;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26rpx;
    font-weight: 600;
    color: #ffffff;
    margin-right: 12rpx;
    flex-shrink: 0;
}

.ball.red {
    background: #d9483b;
}

.ball.blue {
    background: #3a6bd9;
}

.ball.sm {
    width: 48rpx;
    height: 48rpx;
    font-size: 22rpx;
}

.ball-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
}

.game-switch {
    display: flex;
    background: #ffffff;
    border-radius: 16rpx;
    margin: 20rpx 24rpx 0;
    padding: 8rpx;
}

.switch-item {
    flex: 1;
    text-align: center;
    padding: 16rpx 0;
    font-size: 28rpx;
    color: #5c6067;
    border-radius: 12rpx;
}

.switch-item.active {
    background: #d9483b;
    color: #ffffff;
    font-weight: 600;
}

.empty-state {
    text-align: center;
    padding: 120rpx 40rpx;
    color: #8a8f99;
}

.empty-state .empty-icon {
    font-size: 88rpx;
    margin-bottom: 24rpx;
}

.empty-state .empty-text {
    font-size: 28rpx;
}
