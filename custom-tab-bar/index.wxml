<view class="tab-bar">
    <view class="tab-pill" style="transform: translateX({{selected * 100}}%);"></view>
    <view
        class="tab-item {{selected === index ? 'active' : ''}}"
        wx:for="{{list}}"
        wx:key="pagePath"
        data-index="{{index}}"
        bindtap="switchTab"
    >
        <view class="tab-icon" wx:if="{{item.icon}}"></view>
        <text class="tab-text">{{item.text}}</text>
    </view>
</view>
